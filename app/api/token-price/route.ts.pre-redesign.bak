import { NextRequest, NextResponse } from "next/server";

function readNonNegativeNumber(value: unknown): number | null {
  return typeof value === "number" && Number.isFinite(value) && value >= 0
    ? value
    : null;
}

function readNumber(value: unknown): number | null {
  return typeof value === "number" && Number.isFinite(value) ? value : null;
}

function readText(value: unknown): string | null {
  return typeof value === "string" && value.trim() ? value.trim().slice(0, 500) : null;
}

function readHttpsUrl(value: unknown): string | null {
  if (typeof value !== "string") return null;
  try {
    const url = new URL(value);
    return url.protocol === "https:" ? url.toString() : null;
  } catch {
    return null;
  }
}

export async function GET(request: NextRequest) {
  const mint = request.nextUrl.searchParams.get("mint") ?? "";
  if (!/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(mint)) {
    return NextResponse.json({ error: "Invalid Solana mint" }, { status: 400 });
  }

  try {
    const response = await fetch(
      `https://api.dexscreener.com/latest/dex/tokens/${encodeURIComponent(mint)}`,
      { next: { revalidate: 5 }, signal: AbortSignal.timeout(5000) },
    );
    if (!response.ok) {
      return NextResponse.json({ error: "Token price unavailable" }, { status: 502 });
    }
    const payload: unknown = await response.json();
    const pairs =
      typeof payload === "object" && payload !== null && "pairs" in payload && Array.isArray(payload.pairs)
        ? payload.pairs
        : [];
    const bestPair = pairs
      .filter((pair): pair is Record<string, unknown> => typeof pair === "object" && pair !== null)
      .filter((pair) => pair.chainId === "solana" && Number(pair.priceUsd) > 0)
      .sort((a, b) => Number((b.liquidity as { usd?: number } | undefined)?.usd ?? 0) - Number((a.liquidity as { usd?: number } | undefined)?.usd ?? 0))[0];
    const priceUsd = Number(bestPair?.priceUsd);
    if (!Number.isFinite(priceUsd) || priceUsd <= 0) {
      return NextResponse.json({ error: "Token price unavailable" }, { status: 404 });
    }
    const liquidity = readNonNegativeNumber(
      (bestPair.liquidity as { usd?: unknown } | undefined)?.usd,
    );
    const marketCap = readNonNegativeNumber(bestPair.marketCap);
    const volume24h = readNonNegativeNumber(
      (bestPair.volume as { h24?: unknown } | undefined)?.h24,
    );
    const transactions24h = (bestPair.txns as {
      h24?: { buys?: unknown; sells?: unknown };
    } | undefined)?.h24;
    const buys24h = readNonNegativeNumber(transactions24h?.buys);
    const sells24h = readNonNegativeNumber(transactions24h?.sells);
    const priceChanges = bestPair.priceChange as {
      m5?: unknown;
      h1?: unknown;
      h6?: unknown;
      h24?: unknown;
    } | undefined;
    const baseToken = bestPair.baseToken as {
      name?: unknown;
      symbol?: unknown;
    } | undefined;
    const info = bestPair.info as {
      websites?: { url?: unknown }[];
      socials?: { type?: unknown; url?: unknown }[];
      description?: unknown;
    } | undefined;
    const socials = Array.isArray(info?.socials) ? info.socials : [];
    const website = Array.isArray(info?.websites)
      ? info.websites.map((entry) => readHttpsUrl(entry?.url)).find(Boolean) ?? null
      : null;
    const twitter = socials
      .filter((entry) => typeof entry?.type === "string" && entry.type.toLowerCase() === "twitter")
      .map((entry) => readHttpsUrl(entry.url))
      .find(Boolean) ?? null;
    const telegram = socials
      .filter((entry) => typeof entry?.type === "string" && entry.type.toLowerCase() === "telegram")
      .map((entry) => readHttpsUrl(entry.url))
      .find(Boolean) ?? null;
    const pairCreatedAt = readNonNegativeNumber(bestPair.pairCreatedAt);

    return NextResponse.json(
      {
        mint,
        priceUsd,
        name: readText(baseToken?.name),
        symbol: readText(baseToken?.symbol),
        description: readText(info?.description),
        marketCap: marketCap !== null && marketCap > 0 ? marketCap : null,
        liquidity,
        volume24h,
        buys24h,
        sells24h,
        priceChange: {
          m5: readNumber(priceChanges?.m5),
          h1: readNumber(priceChanges?.h1),
          h6: readNumber(priceChanges?.h6),
          h24: readNumber(priceChanges?.h24),
        },
        dexId: readText(bestPair.dexId),
        pairCreatedAt,
        website,
        twitter,
        telegram,
        updatedAt: new Date().toISOString(),
      },
      { headers: { "Cache-Control": "public, max-age=5, stale-while-revalidate=10" } },
    );
  } catch (error) {
    console.error("[token price]", error);
    return NextResponse.json({ error: "Token price unavailable" }, { status: 502 });
  }
}
